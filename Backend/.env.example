PORT=3001
# Production: required comma-separated exact HTTPS frontend origins, no wildcard.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# NODE_ENV=production
# Optional verified proxy IP/CIDR list. Never trust arbitrary forwarded headers.
# TRUSTED_PROXY_CIDRS=
# Supabase credentials are only needed by the separate npm run seed CLI.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
