# Inject through the process environment; this server does not auto-load .env.
PORT=3000
BIND_HOST=127.0.0.1
SQLITE_PATH=database.sqlite
# Keep false unless this is an isolated private service with configured credentials.
ENABLE_ADMIN_HTTP=false
# Required when enabled, at least 32 random characters. Never put in browser env vars.
CRAWLER_ADMIN_SECRET=
KAKAO_PAGE_MIN_GAP_MS=800
