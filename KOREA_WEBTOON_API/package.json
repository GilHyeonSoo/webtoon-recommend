  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "axios-retry": "^4.4.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/index.ts",
    "start": "ts-node -r tsconfig-paths/register src/index.ts",
    "export:sample": "ts-node -r tsconfig-paths/register src/scripts/export-sample-json.ts",
    "enrich:naver": "ts-node -r tsconfig-paths/register src/scripts/enrich-naver-metadata.ts",
    "export:platform": "ts-node -r tsconfig-paths/register src/scripts/export-by-platform-json.ts",
    "test:common-fields": "ts-node -r tsconfig-paths/register src/scripts/test-common-fields.ts",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register/transpile-only -r tsconfig-paths/register --test tests/*.test.ts"
  },
  "devDependencies": {
    "@hyeokjaelee/prettier-config": "^1.3.5",
    "@types/cors": "^2",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/swagger-jsdoc": "^6",
    "@types/swagger-ui-express": "^4.1.6",
