    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.4.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.3.1"
  },
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=22.12.0"
